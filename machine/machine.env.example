# 复制为 machine/machine.env 后填写。machine/machine.env 不进版本库。
# SSH 地址和本地普通账号(只允许专用密钥登录)
LAPTOP_HOST=192.0.2.10
LAPTOP_USER=ffr
# 你登录桌面的账号:计划任务以它的身份启动游戏
LAPTOP_DESKTOP_USER=DOMAIN\user
# SSH 私钥,默认 ~/.ssh/ffr_laptop_ed25519
# LAPTOP_KEY=~/.ssh/ffr_laptop_ed25519
# 游戏机上的工作目录:会话请求、UE4SS 安装清单都放这里
LAPTOP_ROOT=C:/ffr
# 桌面会话计划任务名,不写默认 FFR-Agent-Session。
# 游戏机上已注册姊妹项目 FFR 的任务、请求格式一样时,可填 FFPR-Agent-Session 直接复用。
# LAPTOP_SESSION_TASK=FFPR-Agent-Session
# FINAL FANTASY RESONANCE 的 Win64 目录(里面是游戏 exe、dwmapi.dll 和 ue4ss/)
FFR_GAME_DIR=C:/Program Files (x86)/Steam/steamapps/common/FINAL FANTASY RESONANCE/FFRS/Binaries/Win64
# Steam AppID(商店页面 URL 里 /app/ 后面的数字),只有 game-launch 用
FFR_APP_ID=
